PORT=5000
# IMPORTANT: set NODE_ENV=production when deploying
NODE_ENV=development

# Database configuration
# Prefer a full connection string: postgresql://USER:PASSWORD@HOST:PORT/DB
# In production, do NOT use the default 'postgres' password (startup refuses to launch).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=loyalty_db

# Security & JWT
# REQUIRED in production: must be a long, random, unique value (e.g. `openssl rand -base64 48`).
# Startup will refuse to launch in production with the default or an empty value.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
# Keep short lived (e.g. 8h-24h). Do not use 90d+.
JWT_EXPIRES_IN=24h

# Multi-tenancy default (single-tenant constant for now)
DEFAULT_TENANT_ID=BAC-MAIN

# RealBooks Integration API
# In production, set a real API key. The mock client is used while unset.
REALBOOKS_API_URL=https://api.realbooks.in/v1/redemptions
REALBOOKS_API_KEY=REPLACE_WITH_REALBOOKS_API_KEY