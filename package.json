{
  "name": "automobile-loyalty-backend",
  "version": "1.0.0",
  "description": "Scaffold for Automobile Dealership Group Loyalty Program Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "cd client && npm install && npm run build",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:dry-run": "node src/db/migrate.js --dry-run",
    "db:backup": "node scripts/db-backup.js",
    "seed": "node src/db/seed.js",
    "test": "node scripts/test-api.js",
    "test:regression": "node scripts/test-regression.js"
  },
  "keywords": [
    "loyalty",
    "express",
    "postgresql",
    "jwt",
    "pg_trgm"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
